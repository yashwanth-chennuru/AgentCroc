# Required: AgentMail API key for this agent's inbox
AGENTMAIL_API_KEY=am_...

# Required: this agent's AgentMail inbox id (usually the email address)
AGENTCROC_INBOX_ID=agentA@agentmail.to

# Optional: default download directory for receive_file
AGENTCROC_DOWNLOAD_DIR=./downloads

# Optional: path to croc binary (defaults to "croc" on PATH)
# CROC_BIN=/usr/local/bin/croc

# Optional: override public croc relay (defaults to croc's built-in public relay)
# CROC_RELAY=142.132.189.179:9009
# CROC_PASS=pass123

# Optional: stored-transfer origin (defaults to https://getcroc.com)
# CROC_STORE_URL=https://getcroc.com
