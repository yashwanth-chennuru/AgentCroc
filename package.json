{
  "name": "agentcroc",
  "version": "0.1.3",
  "description": "Agent-to-agent E2E file transfer via croc + AgentMail identity offers (MCP)",
  "type": "module",
  "bin": {
    "agentcroc": "./bin/agentcroc.js"
  },
  "main": "./dist/index.js",
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node bin/agentcroc.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx src/offer.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashwanth-chennuru/AgentCroc.git"
  },
  "keywords": [
    "mcp",
    "croc",
    "agentmail",
    "file-transfer",
    "agents"
  ],
  "author": "Yashwanth Chennuru",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yashwanth-chennuru/AgentCroc/issues"
  },
  "homepage": "https://github.com/yashwanth-chennuru/AgentCroc#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agentmail": "^0.5.19",
    "dotenv": "^17.2.1",
    "tsx": "^4.20.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "typescript": "^5.9.2"
  }
}
